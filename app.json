{
  "expo": {
    "name": "StarBo",
    "slug": "star-kid",
    "version": "1.0.1",
    "orientation": "default",
    "splash": {
      "image": "./assets/images/starbo-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#3B1F8F"
    },
    "icon": "./assets/images/starbo-icon.png",
    "scheme": "starkid",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mi.bstar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/starbo-adaptive-fg.png",
        "backgroundColor": "#3B1F8F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mi.bstar"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3B1F8F",
          "image": "./assets/images/starbo-logo.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0f35dfe-7884-45f7-9d56-21bb14f8f635"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "eanas"
  }
}
