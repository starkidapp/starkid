{
  "expo": {
    "name": "Star Kid",
    "slug": "star-kid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/star-icon.png",
    "splash": {
      "image": "./assets/images/star-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#87CEEB"
    },
    "scheme": "starkid",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mi.starkid",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/star-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mi.starkid"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/star-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#87CEEB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0f35dfe-7884-45f7-9d56-21bb14f8f635"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "eanas"
  }
}
